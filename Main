		  s.nextLine();
       System.out.println("Thanks for using our Reel Cinema management!!!! :D"); 
       System.out.println("We hope you have enjoyed it <33");
       
	  System.out.print("DrUhood, kindly write your Feedback on our project ");
	String feedback = s.nextLine(); // get feedback from instructor
      System.out.println("Thank you so much :)");
      //excpetional handling with try catch in print writer 
	 try {
	PrintWriter writer = new PrintWriter("Feedback.txt"); // create a new file called Feedback
	writer.println(feedback); // write instructor feedback into file
	  writer.close(); // closing the file
	  System.out.println("Your feedback has been saved. Thank you DrUhood!");}
      catch (FileNotFoundException e) { //when there is a problem 
	System.out.println("sorry could not save your feedback :( ");
	 e.printStackTrace();}
			    System.out.println("closing our program");
			    System.out.println("Goodbye!  ");
System.exit(0); // exit program
			}

	  }
	 

